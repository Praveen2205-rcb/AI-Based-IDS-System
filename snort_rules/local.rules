# 1. Informational / Normal Traffic
alert icmp any any -> any any (msg:"ICMP Ping Detected"; sid:1000001; rev:1;)
alert tcp any any -> any 23 (msg:"Telnet Connection Detected"; sid:1000002; rev:1;)

# 2. Denial of Service (DoS) Attacks
alert tcp any any -> any any (flags:S; msg:"TCP SYN Flood Detected"; sid:1000003; rev:1;)
alert udp any any -> any any (msg:"UDP Flood Detected"; sid:1000004; rev:1;)
alert icmp any any -> any any (itype:8; msg:"ICMP Flood Detected"; sid:1000005; rev:1;)
alert udp any 53 -> any any (msg:"DNS Amplification Attack"; sid:1000006; rev:1;)

# 3. Reconnaissance / Port Scans
alert tcp any any -> any any (flags:0; msg:"NULL Scan Detected"; sid:1000007; rev:1;)
alert tcp any any -> any any (flags:F; msg:"FIN Scan Detected"; sid:1000008; rev:1;)
alert tcp any any -> any any (flags:FPU; msg:"XMAS Scan Detected"; sid:1000009; rev:1;)

# 4. Exploits / Web Attacks
alert tcp any any -> any 80 (msg:"HTTP SQL Injection Attempt"; content:"SELECT"; nocase; sid:1000010; rev:1;)
alert tcp any any -> any 80 (msg:"HTTP XSS Attempt"; content:"<script>"; nocase; sid:1000011; rev:1;)
alert tcp any any -> any 80 (msg:"HTTP Directory Traversal"; content:"../"; sid:1000012; rev:1;)

# 5. Brute Force / Backdoors
alert tcp any any -> any 21 (msg:"FTP Brute Force Attempt"; sid:1000013; rev:1;)
alert tcp any any -> any 22 (msg:"SSH Brute Force Attempt"; sid:1000014; rev:1;)
